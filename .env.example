# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="mysql://user:password@localhost:3306/ems_db"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
AUTH_SECRET="generate with: npx auth secret"

# Assistant chatbot (see README "Assistant" section)
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-5-mini"
# Read-only MySQL user for model-written queries — created by
# scripts/assistant-readonly.sql (set the same password in both places).
DATABASE_URL_READONLY="mysql://ems_assistant_ro:CHANGE_ME@localhost:3306/ems_db"
